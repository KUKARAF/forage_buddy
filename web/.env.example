# Copy to .env (web prod build) or set these at build time for the Tauri app.
#
# PUBLIC_API_BASE_URL: absolute URL of the deployed backend. Leave empty/unset
# for a same-origin web deployment (the backend serves web/build itself via
# FORAGEBUDDY_STATIC_DIR). MUST be an absolute URL for the Tauri Android build,
# since the webview is served from tauri.localhost, not the backend's origin.
PUBLIC_API_BASE_URL=

# PUBLIC_APP_MODE: "web" or "tauri". Controls:
#  - whether the device-token bearer auth / deep-link login flow is used
#    instead of cookie sessions
#  - whether @tauri-apps/plugin-geolocation is used instead of
#    navigator.geolocation
#  - whether <img> photo sources are fetched as blobs (bearer auth can't ride
#    along on a plain <img src>) instead of linked directly
PUBLIC_APP_MODE=web

# PUBLIC_BUILD_SHA: short commit SHA, set by CI (docker-publish.yml,
# android-nightly.yml, android-release.yml). Shown as a small footer in the
# app so it's always obvious which build you're actually running. Leave
# unset in local dev — the footer just doesn't render.
PUBLIC_BUILD_SHA=
